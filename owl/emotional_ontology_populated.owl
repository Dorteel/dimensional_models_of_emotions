<owl:NamedIndividual rdf:about="#definition_671c426620a5e4e5">
  <rdf:type rdf:resource="#Definition"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a favorable attitude toward an idea, situation, person, or group. In the context of psychotherapy and counseling, it is the receptive, nonjudgmental attitude of therapists or counselors, which conveys an implicit respect and regard for their clients as individuals.</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_43140d84073376cf">
  <rdf:type rdf:resource="#Definition"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">general agreement that something is satisfactory or right, or that someone should be included in a group</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_68a9bfc72410fe00">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_4e3914743f392925"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient or resigned endurance or toleration (of a difficult, unpleasant, or trying situation or event).</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_4e3914743f392925">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.oed.com/dictionary/acceptance_n?tab=meaning_and_use#40354796</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_16fff923da477349">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a disposition to tolerate or accept people or situations; \"all people should practice toleration and live together in peace\"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_367f8ce80f1b35bd">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://github.com/aesuli/SentiWordNet/blob/master/data/SentiWordNet_3.0.0.txt</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_0cfb3f64c6d8a093">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_de84bc3dab16d788"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling of admiring someone or something</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_de84bc3dab16d788">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/admiration</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_a39ae86d4c0473e4">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of delighted approval and liking</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_d4171a96796ef554">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a positive feeling of liking; "he had trouble expressing the affection he felt"; "the child won everyone's heart"; "the warmness of his welcome made us feel right at home"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_9c293adb0fcd74e1">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fond feelings; love; tenderness</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_dd75a74b1582fdd1">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://doi.org/10.1109/CVPR.2017.212</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_af9437d115edab47">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_b4321f1d486b643f"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a tendency toward social dominance, threatening behavior, and hostility. It may occur sporadically or be a characteristic trait of an individual</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_b4321f1d486b643f">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/aggressiveness</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_64b3bd509bf7ef70">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_88259ff4bb41f682"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the quality of being likely to attack other people or animals, or to behave in a violent or angry way towards them</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_88259ff4bb41f682">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/aggressiveness</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_6a76e203a90cb6e0">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">characteristic of an enemy or one eager to fight; \"aggressive acts against another country\"; \"a belligerent tone\"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_014f4d05b291ebc5">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">experiencing a sudden sense of danger</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_e2c018d44eebdc5b">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_5fc0ce54b00d65fa"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extreme surprise</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_5fc0ce54b00d65fa">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/amazement</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_605573b3a9a10602">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling that accompanies something extremely surprising; \"he looked at me in astonishment\"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_f714f33d8291bdd3">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of delight at being entertained</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_26a852f2e764d3fe">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_eec6ef492fb6e588"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an emotion characterized by tension and hostility arising from frustration, real or imagined injury by another, or perceived injustice. It can manifest itself in behaviors designed to remove the object of the anger (e.g., determined action) or behaviors designed merely to express the emotion (e.g., swearing).</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_eec6ef492fb6e588">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/anger</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_62b773b9b7de7ce7">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_cb0b75004a0cd02d"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a strong feeling that makes you want to hurt someone or be unpleasant because of something unfair or unkind that has happened</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_cb0b75004a0cd02d">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/anger</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_a7aba9f45e1e51ce">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the state of being angry</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_c996d6c970ae7cc1">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">intense displeasure or rage; furious; resentful</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_e4184326108d7a4a">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_3f232b06394b487e"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling or state of being annoyed</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_3f232b06394b487e">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/annoyance</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_7dbe94d4e9615b71">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anger produced by some annoying irritation</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_dcf174c0fab98da2">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bothered by something or someone; irritated; impatient; frustrated</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_705edbb32a251a78">
  <rdf:type rdf:resource="#Definition"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">looking forward to a future event or state, sometimes with an affective component (e.g., pleasure, anxiety)</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_0296079a8d23e271">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_11e496c10647cc02"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of excitement about something that is going to happen in the near future</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_11e496c10647cc02">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/anticipation</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_aac03928e5aab62e">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anticipating with confidence of fulfillment</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_90e89f6e1284fe86">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">state of looking forward; hoping on or getting prepared for possible future events</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_87d54d73b2065edf">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a vague unpleasant emotion that is experienced in anticipation of some (usually ill-defined) misfortune</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_aac9682963bb8286">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_8577d85913d89d47"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uneasiness or dread about an upcoming event or the future generally</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_8577d85913d89d47">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/apprehension</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_f5bb5a1d047862e6">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_b3b21dd9927e0c7d"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">worry about the future, or a fear that something unpleasant is going to happen</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_b3b21dd9927e0c7d">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/apprehension</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_577f15ec8b26cefe">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fearful expectation or anticipation; \"the student looked around the examination room with apprehension\"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_45cf74435ea5fcde">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">keenly excited (especially sexually) or indicating excitement; "his face all ablaze with excitement"- Bram Stoker; "he was aflame with desire"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_d771fe4388e1650c">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filled with the emotional impact of overwhelming surprise or shock; "an amazed audience gave the magician a standing ovation"; "I stood enthralled, astonished by the vastness and majesty of the cathedral"; "astounded viewers wept at the pictures from the Oklahoma City bombing"; "stood in stunned silence"; "stunned scientists found not one but at least three viruses"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_d7af54ce3b5d2f2f">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of being at ease in a relationship</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_38c2a01d3d70f6f7">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of intense dislike</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_d9a74416687b42b4">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feeling disgust, dislike, repulsion; feeling hate</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_15b711133ca086f9">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_a9b29ecfec7f34a2"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the experience of admiration and elevation in response to physical beauty, displays of exceptional ability, or moral goodness.</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_a9b29ecfec7f34a2">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/awe</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_2872b80c9434533c">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_30b0a84272b17af9"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of great respect sometimes mixed with fear or surprise</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_30b0a84272b17af9">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/awe</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_43cdd263b6143e8a">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an overwhelming feeling of wonder or admiration; \"he stared over the edge with a feeling of awe\"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_78f1f8ce74641906">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_872e3d483dd22da3"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a state of weariness or ennui resulting from a lack of engagement with stimuli in the environment.</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_872e3d483dd22da3">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/boredom</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_d5146a5b1d46ac35">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_7a23ffe85836049f"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the state of being bored</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_7a23ffe85836049f">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/boredom</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_e6f96eadc6b840c2">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling of being bored by something tedious</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_8ddff60f86a2916f">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">not agitated; without losing self-possession; "spoke in a calm voice"; "remained calm throughout the uproar"; "he remained serene in the midst of turbulence"; "a serene expression on her face"; "she became more tranquil"; "tranquil life in the country"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_642abc30ca236d2d">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">freedom from doubt; belief in yourself and your abilities; "his assurance in his superiority did not make him popular"; "after that failure he lost his confidence"; "she spoke with authority"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_c4d5e3c84a79457e">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feeling of being certain; conviction that an outcome will be favorable; encouraged; proud</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_fd8891d66296b390">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a mental state characterized by a lack of clear and orderly thought and behavior; "a confusion of impressions"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_8eaacb64c125552a">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_ea35bc8fa0d35522"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an emotion characterized by negative regard for anything or anybody considered to be inferior, vile, or worthless</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_ea35bc8fa0d35522">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/contempt</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_0b7967b98efe946e">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_497e592237e3fcec"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a strong feeling of disliking and having no respect for someone or something</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_497e592237e3fcec">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/contempt</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_46ac7dc662382f11">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lack of respect accompanied by a feeling of intense dislike; \"he was held in contempt\"; \"the despite in which outsiders were held is legendary\"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_c94a09859e5685ad">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the state of being contented with your situation in life; "he relaxed in sleepy contentedness"; "they could read to their heart's content"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_f8e019e5f3526297">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of extreme pleasure or satisfaction; "his delight to see her was obvious to all"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_f83dec500ddafaa9">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">being under the power or sovereignty of another or others; "subject peoples"; "a dependent prince"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_6e42019d46ab4c41">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filled with melancholy and despondency ; "gloomy at the thought of what he had to face"; "gloomy predictions"; "a gloomy silence"; "took a grim view of the economy"; "the darkening mood"; "lonely and blue in a strange city"; "depressed by the loss of his job"; "a dispirited and resigned expression on her face"; "downcast after his defeat"; "feeling discouraged and downhearted"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_75e83f9ee7a1d855">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_2ff83e0d56aae2ec"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling of being disappointed</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_2ff83e0d56aae2ec">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/disappointment</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_498171ea1e6e5e37">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of dissatisfaction that results when your expectations are not realized; \"his hopes were so high he was doomed to disappointment\"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_f875793988652a13">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of disliking something or what someone is doing</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_033dbb4967ade4ae">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feeling that something is wrong or reprehensible; contempt; hostile</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_5ac2a50c788f47bf">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an unbridgeable disparity (as from a failure of understanding); "he felt a gulf between himself and his former friends"; "there is a vast disconnect between public opinion and federal policy"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_fd1b673e69a584b9">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feeling not interested in the main event of the surrounding; indifferent; bored; distracted</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_cdac204b58f1c3f8">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">expressing extreme contempt</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_05eaceffbb4ead8b">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_3a4be5480aeaef53"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a strong aversion, for example, to the taste, smell, or touch of something deemed revolting, or toward a person or behavior deemed morally repugnant</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_3a4be5480aeaef53">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/disgust</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_f67bdfe6cbe3aa0f">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_726e618f11a2d346"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a strong feeling of disapproval and dislike at a situation, person's behaviour, etc.</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_726e618f11a2d346">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/disgust</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_0d0ba4d6e6a4cb7f">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">strong feelings of dislike</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_54afaba567dfa478">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disturb in mind or make uneasy or cause to be worried or alarmed; "She was rather perturbed by the news that her father was seriously ill"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_c9944a55e8ced23f">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nervous; worried; upset; anxious; tense; pressured; alarmed</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_43e8535af1c0aa4e">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_60ce78c4cf5fd84d"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">difficulty in maintaining attention or a tendency to be easily diverted from the matter at hand</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_60ce78c4cf5fd84d">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dictionary.apa.org/distractibility</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_ffea146d82f3bf8d">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_d27f6f076d08b943"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the state of being very bored or annoyed</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_d27f6f076d08b943">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/distraction</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_b2bd0578417f8789">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mental turmoil; \"he drives me to distraction\"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_30e4cc4edd5f30e1">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psychological suffering; "the death of his wife caused him great distress"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_7ce4fb3f1b149bec">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">willing to be taught or led or supervised or directed; "the docile masses of an enslaved nation"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_030b3c222eb4dc2a">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uncertainty about the truth or factuality or existence of something; "the dubiousness of his claim"; "there is no question about the validity of the enterprise"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_81654d5ca01d2639">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">difficulty to understand or decide; thinking about different options</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_0c82555077258eb9">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hanging down (as from exhaustion or weakness)</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_e9b1514f661e79a4">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_cca3e05c46c8a748"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of intense pleasure and elation, including that experienced in some mystical states, during orgasm, with aesthetic reveries, and in drug-induced states.</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_cca3e05c46c8a748">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/ecstasy</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_228725c8b345efad">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dba254960099427b"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a state of extreme happiness, especially when feeling pleasure</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_dba254960099427b">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/ecstasy</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_906f555c26e0eb3c">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a state of being carried away by overwhelming emotion; \"listening to sweet music in a perfect rapture\"- Charles Dickens"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_e1029ccfaef4850d">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feeling or caused to feel uneasy and self-conscious; "felt abashed at the extravagant praise"; "chagrined at the poor sales of his book"; "was embarrassed by her child's tantrums"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_9984d6273c14b1e0">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feeling ashamed or guilty</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_49860d3b9c0ba621">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">having ones attention or mind or energy engaged; "she keeps herself fully occupied with volunteer activities"; "deeply engaged in conversation"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_86f6a40df730ac47">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paying attention to something; absorbed into something; curious; interested</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_ec1f9bf0dae77303">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of delighted approval and liking</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_9c442c7aaed7a995">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feelings of favorable opinion or judgment; respect; admiration; gratefulness</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_6d3fe41e58c7f306">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(of persons) excessively affected by emotion; "he would become emotional over nothing at all"; "she was worked up about all the noise"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_5f9ae290dbdbb591">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feeling enthusiasm; stimulated; energetic</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_c902a97fcebba7b5">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">joyously unrestrained</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_89b2a624a3a6be09">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporary loss of strength and energy resulting from hard physical or mental work; "he was hospitalized for extreme fatigue"; "growing fatigue was apparent from the decline in the execution of their athletic skills"; "weariness overcame her after twelve hours and she fell asleep"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_b7476d11e854cf05">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weariness; tiredness; sleepy</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_b0ec903da36e1db5">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_396118046cf6e879"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a basic, intense emotion aroused by the detection of imminent threat, involving an immediate alarm reaction that mobilizes the organism by triggering a set of physiological changes</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_396118046cf6e879">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/fear</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_8d89411e90f9f505">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_3b755d3a9655f3ab"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an unpleasant emotion or thought that you have when you are frightened or worried by something dangerous, painful, or bad that is happening or might happen</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_3b755d3a9655f3ab">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/fear</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_d48dade710827f64">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an emotion experienced in anticipation of some specific pain or danger (usually accompanied by a desire to flee or fight)</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_b68e8a89c8c38415">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feeling suspicious or afraid of danger, threat, evil or pain; horror</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_a554762fc38f6f75">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling that accompanies an experience of being thwarted in attaining your goals</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_e140cbf142ac39b7">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feeling happy appreciation; "glad of the fire's warmth"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_71b0d0c62d018a44">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">depressingly dark; "the gloomy forest"; "the glooming interior of an old inn"; "`gloomful' is archaic"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_8082de08e27bd786">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_8e48b836166b2667"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the anguish experienced after significant loss, usually the death of a beloved person.</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_8e48b836166b2667">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/grief</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_d771481443024254">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_8d6f770122ddb66a"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">very great sadness, especially at the death of someone</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_8d6f770122ddb66a">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/grief</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_7a72b24337af65c9">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">intense sorrow caused by loss of a loved one (especially by death)</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_310c81579967222a">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feeling delighted; feeling enjoyment or amusement</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_ddcfa6d6b2192d3c">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">state of well-being characterized by emotions ranging from contentment to intense joy</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_eba27e4ff772f83e">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling of a hostile person; "he could no longer contain his hostility"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_ffbc9f01a9b6fc86">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_65db6854bbe54630"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">attitude characterized by a need or desire to give selective attention to something that is significant to the individual, such as an activity, goal, or research area.</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_65db6854bbe54630">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/interest</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_7db81dc91879cae2">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_5d6810f99598b224"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling of wanting to give your attention to something or of wanting to be involved with and to discover more about something</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_5d6810f99598b224">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/interest</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_26e95982de5cb760">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_7239de9ef7f99e00"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The quality or condition of having an involvement with or stake in something; esp. the fact of being motivated by considerations of personal benefit; self-interest.</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_7239de9ef7f99e00">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.oed.com/dictionary/interestedness_n</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_0f72cc7eccf35121">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">be of importance or consequence; \"This matters to me!\"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_536f2775d4ea45c6">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_9c2ba12bedb84b26"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of extreme gladness, delight, or exultation of the spirit arising from a sense of well-being or satisfaction.</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_9c2ba12bedb84b26">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/joy</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_9eda330602cd70f9">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_c7929cc4fa5be1db"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">great happiness</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_c7929cc4fa5be1db">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/joy</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_7a96682426e4c0ae">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feel happiness or joy</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_f73d89b66340accd">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_8f536058420edcd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a strong feeling of hating someone or something</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_8f536058420edcd1">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/loathing</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_468d41fde52c99d9">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hate coupled with disgust</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_115f3db346afcff9">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_6f6620509c3fe7b3"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a complex emotion involving strong feelings of affection and tenderness for the love object, pleasurable sensations in their presence, devotion to their well-being, and sensitivity to their reactions to oneself.</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_6f6620509c3fe7b3">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/love</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_fbad7cdbee49eb21">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_d47199cabc912a9a"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to like something very much</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_d47199cabc912a9a">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/love</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_ea9f2819a23a36da">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">have a great affection or liking for; \"I love French food\"; \"She loves her boss and works hard for him\"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_c0e87b1c1b23a8a1">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">very unhappy; full of misery; "he felt depressed and miserable"; "a message of hope for suffering humanity"; "wretched prisoners huddled in stinking cages"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_0fcc42d05e57830d">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">having no personal preference; "impersonal criticism"; "a neutral observer"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_3684c04380f52662">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_4f027c370784ef48"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hopefulness: the attitude that good things will happen and that peopleâ€™s wishes or aims will ultimately be fulfilled</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_4f027c370784ef48">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/optimism</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_d3a45e44b2d71c7f">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_1dffcc5d06b7d63a"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the quality of being full of hope and emphasizing the good parts of a situation, or a belief that something good will happen</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_1dffcc5d06b7d63a">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/optimism</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_e8672d7445ba0f09">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the optimistic feeling that all is going to turn out well</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_87c45cf6f797886d">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">emotional distress; a fundamental feeling that people try to avoid; "the pain of loneliness"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_d7e6bc14d665ea64">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical suffering</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_29896dd1d3b669aa">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">not disturbed by strife or turmoil or war; "a peaceful nation"; "peaceful times"; "a far from peaceful Christmas"; "peaceful sleep"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_09b3908fd12235a9">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">well being and relaxed; no worry; having positive thoughts or sensations; satisfied</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_ede2f1e9b95c198e">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_4fb32fb5986f1f34"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">thinking in a quiet way, often with a serious expression on your face</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_4fb32fb5986f1f34">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/pensive</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_5241f5dabc34fa66">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deep serious thoughtfulness</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_49ab170d670abefe">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feeling pleasurable satisfaction over something by which you measures your self-worth; "proud of their child"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_6622c14c7ba1ae74">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a fundamental feeling that is hard to define but that people desire to experience; "he was tingling with pleasure"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_3946712059c00746">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feeling of delight in the senses</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_4506c21fd3cc0b13">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_5d4a6675034f0bce"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">intense, typically uncontrolled anger</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_5d4a6675034f0bce">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/rage</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_a5864818e36901a7">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_23c00da1af17a416"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(a period of) extreme or violent anger</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_23c00da1af17a416">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/rage</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_6a1442cb29f84535">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of intense anger; \"hell hath no fury like a woman scorned\"; \"his face turned red with rage\"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_e6403da55b8fd330">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of refreshing tranquility and an absence of tension or worry; "the easiness we feel when sleeping"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_483ee0a4af071e92">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_414871662c02de23"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a strong sense of guilt and regret for a past action</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_414871662c02de23">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/remorse</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_4bbe31af2270a4ae">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_2682082b87b9720a"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of sadness and being sorry for something you have done</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_2682082b87b9720a">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/remorse</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_6c4ce941393395ea">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of deep regret (usually for some misdeed)</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_6071469db9c850b5">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_8b3067e1a399beba"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an emotional state of unhappiness, ranging in intensity from mild to extreme and usually aroused by the loss of something that is highly valued (e.g., by the rupture of a relationship).</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_8b3067e1a399beba">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/sadness</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_914ca35aa7628f2b">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_f56d78c00423cb10"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling of being unhappy, especially because something bad has happened</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_f56d78c00423cb10">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/sadness</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_2f86bc62e2eb27da">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">emotions experienced when not in a state of well-being</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_1e90d046c12b2e85">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feeling unhappy, sorrow, disappointed, or discouraged</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_1f73a90aa79d3de0">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the contentment one feels when one has fulfilled a desire, need, or expectation; "the chef tasted the sauce with great satisfaction"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_0d4a11124daef8b1">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sensitivity to emotional feelings (of self and others)</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_91bc99ba36eb3c85">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feeling of being physically or emotionally wounded; feeling delicate or vulnerable</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_30bbfbbf6127d850">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_a39b9d7d7dadfbbe"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the quality of being peaceful and calm</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_a39b9d7d7dadfbbe">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/serenity</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_c432adceaf41f80c">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_10eef6b493698c13"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cheerful tranquillity (of mind, temper, countenance, etc.).</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_10eef6b493698c13">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.oed.com/dictionary/serenity_n?tab=meaning_and_use#23325284</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_0914171fb799a5fc">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a disposition free from stress or emotion</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_7e1f010d0e7225ea">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a very sleepy state; "sleepiness causes many driving accidents"</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_77e01b6195f6392f">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_f548b28a835c84d1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compliance with or surrender to the requests, demands, or will of others.</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_f548b28a835c84d1">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/submission</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_2856d1f5e284f372">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_6d3addc961f76054"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a willingness to allow control by other people or animals, or behaviour that shows this</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_6d3addc961f76054">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/submissiveness</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_3d98b48885fec231">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling of patient, submissive humbleness</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_1b547f23aab90e53">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feelings of mental or physical pain</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_0ecc30a4bfd04aa4">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">psychological or emotional pain; distressed; anguished</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_aba5bf39000689a2">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_7ec10defadf35020"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an emotion typically resulting from the violation of an expectation or the detection of novelty in the environment.</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_7ec10defadf35020">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/surprise</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_9d8a809937e0360e">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_4b46bae7502ef4cf"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling caused by something unexpected happening</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_4b46bae7502ef4cf">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/surprise</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_ad76bb922a7cff21">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the astonishment you feel when something totally unexpected happens to you</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_d255cbcc5869fdd3">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sudden discovery of something unexpected</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_0bf0c2f2a940a0db">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sharing the feelings of others (especially feelings of sorrow or anguish)</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_e41d51157ef6f9d0">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_dd75a74b1582fdd1"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">state of sharing others emotions, goals or troubles; supportive; compassionate</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_06326aed94757597">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_367f8ce80f1b35bd"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in or of a state of physical or nervous tension</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_1cb0723cd75c724e">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_1d8ece1a2641fb36"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">intense and overwhelming fear</hasValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#source_1d8ece1a2641fb36">
  <rdf:type rdf:resource="#KnowledgeRepository"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/terror</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#definition_87f1487316a38bf1">
  <rdf:type rdf:resource="#Definition"/>
  <hasSource rdf:resource="#source_1471bd52fbe72d3b"/>
  <hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extreme fear</hasValue>
</owl:NamedIndividual>

