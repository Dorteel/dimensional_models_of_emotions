# Quality dimensions of each domain (ecs:hasQualityDimension) and their stated metadata.
# Optional values that are absent stay unbound; nothing is defaulted. A dimension with several values for
# one property yields one row per combination; the query service groups them.
#
# Columns
#   ?domain            the Domain individual
#   ?dimension         a QualityDimension linked with ecs:hasQualityDimension
#   ?label             rdfs:label of the dimension (optional)
#   ?range             ecs:hasRange, a text such as "min=-1,max=1" (optional, not interpreted here)
#   ?circular          ecs:isCircular (optional)
#   ?measurementLevel  ecs:hasMeasurementLevel (optional)

PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ecs:  <http://example.org/conceptual-space-emotion.owl#>

SELECT ?domain ?dimension ?label ?range ?circular ?measurementLevel
WHERE {
  ?domain rdf:type ecs:Domain ;
          ecs:hasQualityDimension ?dimension .
  OPTIONAL { ?dimension rdfs:label ?label }
  OPTIONAL { ?dimension ecs:hasRange ?range }
  OPTIONAL { ?dimension ecs:isCircular ?circular }
  OPTIONAL { ?dimension ecs:hasMeasurementLevel ?measurementLevel }
}
